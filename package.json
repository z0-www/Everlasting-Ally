{
  "name": "everlasting-ally",
  "version": "1.0.0-rc.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test dist/test/*.test.js && node --test test/*.test.mjs",
    "demo:roleplay": "npm run build && node examples/roleplay-memory-demo.mjs",
    "roleplay:manage": "npm run build && node dist/roleplay/manage.js",
    "demo:emotional": "npm run build && node examples/emotional-roleplay-demo.mjs",
    "package:local": "npm run build && npm pack",
    "demo:dialogue": "npm run build && node examples/memory-dialogue-demo.mjs",
    "demo:companion": "npm run build && node examples/companion-roleplay-demo.mjs",
    "demo:roleplay-continuity": "npm run build && node examples/roleplay-continuity-demo.mjs",
    "verify:manifest": "node test/manifest.test.mjs",
    "demo:integrated": "npm run build && node examples/integrated-memory-demo.mjs",
    "test:memory-lifecycle": "npm run build && node --test test/memory-lifecycle.test.mjs",
    "verify:package": "npm run build && node scripts/verify-package.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "@dsh-std/manifest": "0.1.1-rc.3"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": "./dist/index.js",
  "files": [
    "dist",
    "dsh-plugin.json",
    "everlasting-ally.bundle.yml",
    "README.md",
    "AGENTS.md",
    "LICENSE",
    "docs",
    "examples",
    "scripts"
  ],
  "description": "Long-term memory and roleplay continuity plugin for DeepSeek Harness",
  "dsh": {
    "bundle": {
      "patch": "./everlasting-ally.bundle.yml"
    }
  },
  "engines": {
    "node": ">=22.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4",
    "@deepseek-ai/dsh": ">=0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "license": "MIT"
}
